<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>Library Management System</display-name>
  <listener>
    <listener-class>com.ptit.library.web.AppContextListener</listener-class>
  </listener>
  <filter>
    <filter-name>CharacterEncodingFilter</filter-name>
    <filter-class>com.ptit.library.web.CharacterEncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CharacterEncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.ptit.library.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>HealthServlet</servlet-name>
    <servlet-class>com.ptit.library.web.HealthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HealthServlet</servlet-name>
    <url-pattern>/health</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.ptit.library.web.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.ptit.library.web.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>RegisterServlet</servlet-name>
    <servlet-class>com.ptit.library.web.RegisterServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegisterServlet</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>HomeServlet</servlet-name>
    <servlet-class>com.ptit.library.web.HomeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HomeServlet</servlet-name>
    <url-pattern>/home</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffHomeServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffHomeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffHomeServlet</servlet-name>
    <url-pattern>/staff/home</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>ReaderHomeServlet</servlet-name>
    <servlet-class>com.ptit.library.web.ReaderHomeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReaderHomeServlet</servlet-name>
    <url-pattern>/reader/home</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffCatalogServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffCatalogServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffCatalogServlet</servlet-name>
    <url-pattern>/staff/catalog</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffBookServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffBookServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffBookServlet</servlet-name>
    <url-pattern>/staff/books</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffBookCopyServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffBookCopyServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffBookCopyServlet</servlet-name>
    <url-pattern>/staff/books/copies</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>ReaderBookServlet</servlet-name>
    <servlet-class>com.ptit.library.web.ReaderBookServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReaderBookServlet</servlet-name>
    <url-pattern>/reader/books</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>ReaderLoanServlet</servlet-name>
    <servlet-class>com.ptit.library.web.ReaderLoanServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReaderLoanServlet</servlet-name>
    <url-pattern>/reader/my-loans</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>ChangePasswordServlet</servlet-name>
    <servlet-class>com.ptit.library.web.ChangePasswordServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ChangePasswordServlet</servlet-name>
    <url-pattern>/account/password</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffReaderApprovalServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffReaderApprovalServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffReaderApprovalServlet</servlet-name>
    <url-pattern>/staff/readers/pending</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffReaderServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffReaderServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffReaderServlet</servlet-name>
    <url-pattern>/staff/readers</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffLoanCreateServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffLoanCreateServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffLoanCreateServlet</servlet-name>
    <url-pattern>/staff/loans/new</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffLoanReturnServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffLoanReturnServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffLoanReturnServlet</servlet-name>
    <url-pattern>/staff/loans</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffOverdueServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffOverdueServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffOverdueServlet</servlet-name>
    <url-pattern>/staff/overdue</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>StaffDashboardServlet</servlet-name>
    <servlet-class>com.ptit.library.web.StaffDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StaffDashboardServlet</servlet-name>
    <url-pattern>/staff/dashboard</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>AdminStaffUserServlet</servlet-name>
    <servlet-class>com.ptit.library.web.AdminStaffUserServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminStaffUserServlet</servlet-name>
    <url-pattern>/admin/staff-users</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>AdminSettingsServlet</servlet-name>
    <servlet-class>com.ptit.library.web.AdminSettingsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminSettingsServlet</servlet-name>
    <url-pattern>/admin/settings</url-pattern>
  </servlet-mapping>
  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
